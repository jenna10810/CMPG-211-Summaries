% 2. Environment Definition
\newtcblisting{tightcode}[1][\filelang]{%
    listing engine=minted,
    minted language={#1},
    listing only,
    varwidth upper,              % Auto-sizes box width AND keeps line numbers!
    colback=black!20,
    colframe=gray!5,
    top=0.2cm,
    bottom=0.2cm,
    left=0.5cm,
    right=0.2cm,
    minted options={
        linenos=true, 
        numbersep=6pt, 
        fontsize=\small,
        xleftmargin=0.1cm        % Margin reserved for line numbers inside the box
    }
}






