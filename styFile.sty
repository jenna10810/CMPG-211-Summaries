% 1. Global / File-level default language (change this per file or globally)
\newcommand{\filelang}{java}

% 2. Environment Definition
\newtcblisting{tightcode}[1][\filelang]{%
    listing engine=minted,
    minted language={#1}, % Dynamically set to default (\filelang) or overridden
    listing only,
    hbox,
    colback=black!20,
    colframe=gray!5,
    top=0.2cm,
    bottom=0.2cm,
    left=0.5cm,
    right=0.2cm,
    minted options={linenos=true, numbersep=6pt, fontsize=\small}
}







