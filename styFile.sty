breakable,
listing engine=minted, % <-- Forces tcolorbox to use Pygments/minted
listing file={#4},
minted language=#1,
minted style=default, % <-- Forces Pygments color scheme
minted options={
obeytabs=true,
tabsize=4,
linenos,
fontsize=\small,
numbersep=6pt,
breaklines=true,
#3
},
colback=gray!10,
colframe=gray!70,
coltitle=black,
fonttitle=\bfseries,
