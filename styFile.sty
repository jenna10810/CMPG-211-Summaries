% =========================================================================
% 1. Standard Text/Code Columns (LRC)
% Vertically centered fixed-width columns for regular text, code, or strings.
% Usage: L{width}, R{width}, C{width}
% =========================================================================
\newcolumntype{C}[1]{>{\centering\arraybackslash}m{#1}}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}m{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}m{#1}}

% =========================================================================
% 2. Neat Math Columns (NMC)
% Vertically centered fixed-width columns that automatically enter
% display-style math mode: \(\displaystyle ... \)
% Usage: NC{width}, NL{width}, NR{width}
% =========================================================================
\newcolumntype{NC}[1]{>{\centering\arraybackslash\(\displaystyle}m{#1}<{\)}}
\newcolumntype{NL}[1]{>{\raggedright\arraybackslash\(\displaystyle}m{#1}<{\)}}
\newcolumntype{NR}[1]{>{\raggedleft\arraybackslash\(\displaystyle}m{#1}<{\)}}

% Helper macro for multi-line math inside math cells (maintains \displaystyle)
\newcommand{\mmakecell}[2][c]{\makecell[#1]{$\displaystyle #2$}}

