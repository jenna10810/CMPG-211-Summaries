% =========================================================================
% 1. Core Page Setup & Regional Settings
% =========================================================================
\usepackage[english]{babel}
\usepackage[a4paper, top=2cm, bottom=2cm, left=2cm, right=2cm, marginparwidth=1.5cm]{geometry}
\usepackage{comment}
\usepackage{setspace}

% =========================================================================
% 2. Colors, Highlighting, & Text Formatting
% =========================================================================
\usepackage[table, dvipsnames]{xcolor}  % Custom colors & table row/column coloring
\usepackage{cancel}                     % Strike-through in math or text
\usepackage{soul}                       % Highlighting and text decoration
\usepackage{xspace}                     % Smart spacing after macros
\usepackage{pifont}                     % Special symbols (e.g., dingbats, checks)

% Custom text highlighting macro using soul and xcolor
\newcommand{\hlc}[2][yellow]{{%
        \colorlet{foo}{#1}%
        \sethlcolor{foo}\hl{#2}}%
}

% =========================================================================
% 3. Math Support
% =========================================================================
\usepackage[fleqn]{mathtools}         % Loads and extends amsmath
\usepackage{amssymb}

% =========================================================================
% 4. Figures, Images, Diagrams, & Captions
% =========================================================================
\usepackage{graphicx}
\usepackage{wrapfig}
\usepackage{subfig}
\usepackage{float}
\usepackage{tikz}
\usepackage{pgfplots}
\usepackage{pgfplotstable}
\pgfplotsset{compat=1.18}

\usepackage{caption}
\captionsetup{justification=centering}

% Custom circled text using TikZ
\newcommand*\circled[2]{%
    \protect\tikz[baseline=(char.base)]{%
        \protect\node[shape=circle, fill=#1, draw, inner sep=2pt] (char) {\textcolor{black}{#2}};}}

% =========================================================================
% 5. Tables & Alignment
% =========================================================================
\usepackage{array}
\usepackage{multirow}
\usepackage{makecell}
\usepackage{pdflscape}                % Landscape support for wide tables/pages
\usepackage{rotating}                 % Rotating table cells or content
\usepackage{blkarray}                 % Advanced matrix layouts with labels
\usepackage{bigstrut}                 % Struts for matrix/table formatting
\usepackage{nicematrix}               % Modern matrix and table utilities

% Standard Text/Code Columns (Vertically Centered)
\newcolumntype{C}[1]{>{\centering\arraybackslash}m{#1}}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}m{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}m{#1}}

% =========================================================================
% 6. Section & List Formatting
% =========================================================================
\usepackage{titlesec}
\setcounter{secnumdepth}{4}
\titleformat{\paragraph}
{\normalfont\normalsize\bfseries}{\theparagraph}{1em}{}
\titlespacing*{\paragraph}
{0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}

\usepackage{enumitem}                 % Custom lists (itemize, enumerate)

% =========================================================================
% 7. Code Listings & Fancy Boxes (Minted & tcolorbox)
% =========================================================================
\usepackage{varwidth}                 % Required for auto-sizing boxes
\usepackage{listings}
\usepackage{minted}
\usepackage[minted, most]{tcolorbox}
\tcbuselibrary{listings}

\setminted{obeytabs}
\AtBeginEnvironment{minted}{%
    \renewcommand{\fcolorbox}[4][]{#4}}

% Default language for tightcode environment
\newcommand{\filelang}{java}

% Inline highlight code macro
\newtcblisting{hlm}{
    listing only,
    nobeforeafter,
    after={\xspace},
    hbox,
    tcbox raise base,
    fontupper=\ttfamily,
    colback=pink,
    colframe=pink,
    size=fbox
}

% Custom auto-sizing code environment
\newtcblisting{tightcode}[1][\filelang]{%
    listing engine=minted,
    minted language={#1},
    listing only,
    varwidth upper,              % Auto-sizes box width AND keeps line numbers
    colback=black!20,
    colframe=gray!5,
    top=0.2cm,
    bottom=0.2cm,
    left=0.5cm,
    right=0.2cm,
    minted options={
        linenos=true, 
        numbersep=6pt, 
        fontsize=\small,
        xleftmargin=0.1cm        % Margin reserved for line numbers inside the box
    }
}

% Custom styled message box
\NewTColorBox[]{mybox}{ O{red} m d"" !O{} }
{enhanced,colframe=#1!75!black,colback=#1!5!white,
fonttitle=\bfseries,title={#2},
IfValueT={#3}{watermark text={#3}},#4,
before upper={%
    \setlist[itemize]{left=0pt,labelsep=0.5em}%
    \setlist[enumerate]{left=0pt,labelsep=0.5em}%
 }%
}

% Definition Box
\newtcolorbox[auto counter,number within=subsubsection]{definitionCounter}[2][]{%
colback=red!5!white,colframe=red!75!black,fonttitle=\bfseries,
title=Examp.~\thetcbcounter: #2,#1,
before upper={\setlist[itemize]{left=1pt}}}

\NewTColorBox[use counter from=definitionCounter]{definitionbox}{ O{red} m d"" !O{} }
{enhanced,colframe=#1!75!black,colback=#1!5!white,
fonttitle=\bfseries,title=definition {\thetcbcounter~#2},
IfValueT={#3}{watermark text={#3}},#4,
before upper={\setlist[itemize]{left=1pt}}}


