%% lemma
\newtcolorbox[auto counter,number within=subsubsection]{lemmaCounter}[2][]{%
colback=red!5!white,colframe=red!75!black,fonttitle=\bfseries,
title=Examp.~\thetcbcounter: #2,#1,
before upper={\setlist[itemize]{left=1pt}}}

\NewTColorBox[use counter from=lemmaCounter]{lemmabox}{ O{red} m d"" !O{} }
{enhanced,colframe=#1!75!black,colback=#1!5!white,
fonttitle=\bfseries,title=Lemma {\thetcbcounter~#2},
IfValueT={#3}{watermark text={#3}},#4,
before upper={\setlist[itemize]{left=1pt}}}


